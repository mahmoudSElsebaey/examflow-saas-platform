# ============================================================
# ExamFlow Environment Variables
# Copy to .env and fill in production values
# ============================================================

NODE_ENV=production
PORT=5000
API_PORT=5000
WEB_PORT=8080

CLIENT_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Leave empty in Docker so SPA uses same-origin /api/v1 (nginx → api)
VITE_API_URL=

DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/examflow?retryWrites=true&w=majority

# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (optional — default logs to console)
# EMAIL_PROVIDER=log | resend
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=ExamFlow <onboarding@resend.dev>
