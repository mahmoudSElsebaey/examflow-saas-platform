# ============================================================
# ExamFlow Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (MongoDB Atlas)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/examflow?retryWrites=true&w=majority

# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (client/.env)
# VITE_API_URL=http://localhost:5000/api/v1

# Cloudinary / Object Storage (later)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (later)
# EMAIL_FROM=noreply@examflow.app
# RESEND_API_KEY=

# Redis (later phases)
# REDIS_URL=redis://localhost:6379

# Payments (later)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
